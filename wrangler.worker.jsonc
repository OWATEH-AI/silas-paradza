{
  "name": "silas-paradza",
  "main": "./dist/server/entry.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },

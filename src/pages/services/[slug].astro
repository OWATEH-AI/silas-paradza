---
import EditorialPage from "../../components/EditorialPage.astro";
import PortableText from "../../components/PortableText.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import PublicForm from "../../components/PublicForm.astro";
import type { FormDefinition } from "../../sanity/lib/form-types";
import { FORM_FOR_CONTENT_QUERY, SERVICE_QUERY } from "../../sanity/lib/queries";
import { getDraftModeProps, loadQuery } from "../../sanity/lib/load-query";
import { imageUrl } from "../../sanity/lib/image-url";
import { stegaClean } from "@sanity/client/stega";
import type { TypedObject } from "@portabletext/types";
import { env } from "cloudflare:workers";

export const prerender = false;

interface ServicePage {
  title: string;
  slug: string;
  category?: string;
  summary?: string;
  body?: TypedObject[];
  coverImage?: { asset?: { url?: string }; alt?: string };
  videoFile?: { asset?: { url?: string; mimeType?: string } };
  videoUrl?: string;
  videoPoster?: { asset?: { url?: string }; alt?: string };
  seo?: { metaTitle?: string; metaDescription?: string };
}

const { data: service } = await loadQuery<ServicePage | null>({
  query: SERVICE_QUERY,
  params: { slug: Astro.params.slug ?? "" },
  ...getDraftModeProps(Astro.cookies),
  token: env.SANITY_API_READ_TOKEN,
});

if (!service) return new Response(null, { status: 404 });
const { data: attachedForm } = await loadQuery<FormDefinition | null>({
  query: FORM_FOR_CONTENT_QUERY,
  params: { contentType: "service", slug: service.slug },
  ...getDraftModeProps(Astro.cookies),
  token: env.SANITY_API_READ_TOKEN,
});

const title = stegaClean(service.seo?.metaTitle || service.title);
const description = stegaClean(service.seo?.metaDescription || service.summary || "");
const cover = imageUrl(service.coverImage, 1400) ?? service.coverImage?.asset?.url;
---

<EditorialPage title={title} description={description} image={cover}>
  <article class="editorial-article">
    <a class="editorial-back-link" href="/#services">&larr; Back to services</a>
    <header class="editorial-article__header">
      {service.category && <span class="eyebrow">{service.category}</span>}
      <h1 class="section-title">{service.title}</h1>
      {service.summary && <p class="section-subtitle">{service.summary}</p>}
    </header>
    {(service.videoFile?.asset?.url || service.videoUrl) ? (
      <VideoEmbed
        fileUrl={service.videoFile?.asset?.url}
        fileType={service.videoFile?.asset?.mimeType}
        externalUrl={service.videoUrl}
        poster={service.videoPoster?.asset?.url}
        title={service.title}
      />
    ) : cover && <img class="editorial-feature-media" src={cover} alt={service.coverImage?.alt ?? title} />}
    {attachedForm?.ctaPlacement === "beforeContent" && <PublicForm form={attachedForm} />}
    <PortableText value={service.body} />
    {attachedForm && attachedForm.ctaPlacement !== "beforeContent" && <PublicForm form={attachedForm} />}
  </article>
</EditorialPage>
